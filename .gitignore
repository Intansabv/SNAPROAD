# =========================================================
# SNAPROAD — .gitignore
# =========================================================

# ---------- Flutter / Dart ----------
.dart_tool/
.packages
build/
doc/api/
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map
.flutter-plugins
.flutter-plugins-dependencies

# Catatan: pubspec.lock SENGAJA di-commit (best practice untuk aplikasi,
# agar versi dependency sama di semua mesin).

# ---------- Android ----------
android/.gradle/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
*.jks
*.keystore

# ---------- iOS / macOS (kalau nanti ditambahkan) ----------
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
macos/Pods/

# ---------- IDE / OS ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.DS_Store
Thumbs.db

# ---------- Python / notebook ----------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.log

# ---------- Dataset (jangan masuk git, ukurannya GB) ----------
ml/raw/
ml/dataset/
ml/crops/
data/
ml/artifacts/*.zip
*.7z

# ---------- Kredensial & konfigurasi lokal ----------
kaggle.json
**/kaggle.json
.env
.env.*
